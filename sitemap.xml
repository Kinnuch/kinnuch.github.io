---
layout: null
permalink: /sitemap.xml
sitemap: false
---
{%- comment -%}
  Hand-rolled sitemap so no plugin is needed on stock GitHub Pages.
  Pages opt out with `sitemap: false` in their front matter.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign listed = site.pages | where_exp: "p", "p.title" -%}
{%- assign listed = listed | where_exp: "p", "p.sitemap != false" -%}
{%- for p in listed %}
  <url>
    <loc>{{ site.url }}{{ p.url | remove: "index.html" | uri_escape }}</loc>
    {%- if p.url == "/" %}
    <priority>1.0</priority>
    <changefreq>weekly</changefreq>
    {%- else %}
    <priority>0.7</priority>
    <changefreq>monthly</changefreq>
    {%- endif %}
  </url>
{%- endfor %}
{%- for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url | uri_escape }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <priority>0.6</priority>
  </url>
{%- endfor %}
</urlset>
